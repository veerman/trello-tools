TRELLO_API_KEY=your_key_here
TRELLO_API_TOKEN=your_token_here

# Optional. Workspaces to back up, separated by commas; without it, backup.py asks.
# BACKUP_WORKSPACES=My Workspace,Another Workspace

# Optional. Where the board files go (make this folder a private git repo), and where boards left
# out by review_boards.py go (never in git, never uploaded; keep it separate). Relative paths are
# relative to this folder. Defaults: backup, excluded
# BACKUP_DIR=../../my-trello-backup
# EXCLUDED_DIR=../../my-trello-excluded
# Rarely needed: where the attachments are stored. Default: files/ inside BACKUP_DIR, kept out of git.
# FILE_STORE=../../my-trello-files

# Optional. For upload_to_drive.py: the rclone connection's name and the Drive folder to copy the
# file store into. Let the upload create the folder; don't make it yourself in Drive.
# DRIVE_REMOTE=my-drive
# DRIVE_FOLDER=Trello Files - My Workspace
